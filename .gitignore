# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Environments
.venv/
venv/
.env
# Variants too (.env.local, .env.bak-*, editor swap copies): these hold the same
# credential as .env, and `.env` alone does not match them.
.env.*
!.env.example

# Build artifacts
dist/
build/

# Editor noise
.DS_Store
.vscode/
.idea/

# .claude/ holds BOTH local noise (settings.local.json, transcripts) and
# committed project assets (skills, commands). It was ignored wholesale, and the
# eleven tracked skills only survive because someone force-added each one -- so a
# NEW skill is silently not committed, which is how the prioritize-graph-research
# skill reached CI as a test failure rather than as a file. Ignore the directory
# but un-ignore the assets, so `git add -A` does the right thing by default.
.claude/*
!.claude/skills/
!.claude/commands/
# agents/ does not exist yet; listed so a subagent definition added later is
# committed by default rather than repeating the story above.
!.claude/agents/

# Workspace / runtime
workspace/
.snapshots/

# Generated dataclasses (regenerable from schema)
src/traitmech/schema/traitmech_dataclasses.py

# ROBOT/ELK validation outputs for METPO proposals (regenerable with
# `just robot-validate-proposal <cohort>`; merged.owl/reasoned.owl are
# ~500 KB each, dominated by re-serialized metpo.owl).
reports/robot/

# Regenerated by `just audit-snippets`, which runs inside `just qc` — so a
# committed copy is rewritten by an earlier step of the same run and no
# staleness gate can observe it going stale (#268). It is also byte-identical to
# conf/evidence_snippet_baseline.tsv, which IS tracked and IS the artifact with
# meaning: the baseline is the frozen ratchet, this is just the current run.
reports/evidence_snippet_audit.tsv

# research/ is TRACKED. It was ignored as "large, regenerable" until the second
# half of that turned out to be the expensive half: 342 of 353 reports were lost
# because nothing outside one machine held them, and the manifest recorded 353
# successes against 11 surviving files. Regenerating costs a paid Edison call
# per trait (~7.5 min each), so these are provenance, not build output.
